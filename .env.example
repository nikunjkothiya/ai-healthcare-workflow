# =============================================================================
# AI Healthcare Voice Agent — Environment Configuration
# =============================================================================
# Optimized for low-resource local deployment (8-16GB RAM total)
# All models selected for best accuracy/speed ratio on consumer hardware
# =============================================================================

# Database
DB_HOST=postgres
DB_USER=postgres
DB_PASS=postgres
DB_NAME=healthcare
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=supersecret_change_in_production

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# Primary LLM Provider: 'ollama' (local) or 'gemini' (cloud API)
LLM_PROVIDER=ollama

# --- Gemini API (Cloud fallback) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_CHAT=gemini-2.5-flash
GEMINI_MODEL_ANALYSIS=gemini-2.5-flash
GEMINI_MODEL_DECISION=gemini-2.5-flash

# --- Ollama (Local — Primary) ---
OLLAMA_URL=http://ollama:11434

# Stage-specific model selection (all runnable on 8-16GB RAM):
# Realtime chat: llama3.2:3b — best structured JSON output for live calls
OLLAMA_MODEL_CHAT=llama3.2:3b
# Decision/Routing: For intent classification and action decisions
OLLAMA_MODEL_DECISION=llama3.2:3b
# Post-call analysis: Larger model for deep transcript analysis
OLLAMA_MODEL_ANALYSIS=qwen3:8b

# Alternative model options (uncomment to switch):
# OLLAMA_MODEL_CHAT=qwen3:4b           # Fast dual-mode thinking, 119 languages
# OLLAMA_MODEL_CHAT=phi:3.8b           # Best reasoning in small size
# OLLAMA_MODEL_CHAT=gemma3:4b          # 128K context, 140+ languages
# OLLAMA_MODEL_ANALYSIS=llama3.1:8b    # Strong all-rounder
# OLLAMA_MODEL_ANALYSIS=mistral:7b     # Efficient baseline

# =============================================================================
# LLM TUNING PARAMETERS (optimized for local models)
# =============================================================================
LLM_MAX_TOKENS=150
LLM_NUM_CTX=1024
LLM_NUM_CTX_REALTIME=1024
LLM_MAX_TOKENS_ANALYSIS=768
LLM_NUM_CTX_ANALYSIS=4096
LLM_TIMEOUT_MS=30000
LLM_REALTIME_TIMEOUT_MS=30000
LLM_ANALYSIS_TIMEOUT_MS=120000
LLM_ANALYSIS_TRANSCRIPT_MAX_CHARS=18000

# =============================================================================
# STT (Speech-to-Text) — Dual-provider architecture
# =============================================================================

# STT Provider: 'whisper' (default) or 'moonshine' (faster edge inference)
STT_PROVIDER=whisper

# --- Whisper (OpenAI Whisper.cpp server) ---
WHISPER_HOST=whisper
WHISPER_PORT=9000
WHISPER_MODEL_PATH=/models/whisper/ggml-small.en.bin

# --- Moonshine (5x faster edge ASR — optional) ---
# When STT_PROVIDER=moonshine, uses Moonshine for real-time turns
# and Whisper for post-call batch analysis
MOONSHINE_HOST=moonshine
MOONSHINE_PORT=9001
MOONSHINE_MODEL=moonshine/base

# STT Tuning (applies to both providers)
STT_CHUNK_MS=1200
STT_CHUNK_OVERLAP_MS=200
STT_SILENCE_MS=500
STT_VAD_SILENCE_RMS=0.005
STT_MAX_CONCURRENT=3

# =============================================================================
# TTS (Text-to-Speech) — Dual-provider architecture
# =============================================================================

# TTS Provider: 'kokoro' (recommended) or 'coqui' (legacy)
TTS_PROVIDER=kokoro

# --- Kokoro-82M (Recommended — #1 TTS Arena, 82M params, Apache 2.0) ---
KOKORO_HOST=kokoro
KOKORO_PORT=8880
# Voice pack: 'af_bella', 'af_sarah', 'am_adam', 'am_michael', etc.
KOKORO_VOICE=af_bella
KOKORO_LANG=en-us

# --- Coqui TTS (Legacy — Tacotron2 + HiFiGAN) ---
TTS_HOST=tts
TTS_PORT=5002
TTS_MODEL_PATH=/models/tts/tts_models--en--ljspeech--tacotron2-DDC/model_file.pth.tar
TTS_CONFIG_PATH=/models/tts/tts_models--en--ljspeech--tacotron2-DDC/config.json
TTS_VOCODER_PATH=/models/tts/vocoder_models--en--ljspeech--hifigan_v2/model_file.pth.tar
TTS_VOCODER_CONFIG_PATH=/models/tts/vocoder_models--en--ljspeech--hifigan_v2/config.json

REQUIRE_SERVER_TTS=true
VITE_REQUIRE_SERVER_TTS=true

# =============================================================================
# WORKER / ORCHESTRATOR
# =============================================================================
WORKER_CONCURRENCY=1
CALL_SPACING_MS=15000
RING_TIMEOUT_MS=30000
WEBSOCKET_CALL_MAX_WAIT_MS=720000
POST_CALL_ANALYSIS_MAX_WAIT_MS=90000
AUDIO_TMP_DIR=/tmp/healthcare_audio

# =============================================================================
# CALL LIMITS
# =============================================================================
MAX_CALL_DURATION_MS=600000
MAX_CONVERSATION_TURNS=30
MAX_RUNTIME_RAM_GB=14

# =============================================================================
# APP
# =============================================================================
NODE_ENV=production
PORT=4000
CORS_ORIGIN=*
